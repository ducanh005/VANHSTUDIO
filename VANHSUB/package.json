{
  "private": true,
  "name": "vanhstudio",
  "description": "VanhStudio — Ứng dụng phụ đề, lồng tiếng và sản xuất video AI trên desktop",
  "version": "1.0.0",
  "author": "VanhStudio",
  "main": "app/main.js",
  "scripts": {
    "dev": "nextron",
    "build": "npm run build:whisper-cpp && nextron build",
    "build:whisper-cpp": "cmake -S node_modules/nodejs-whisper/cpp/whisper.cpp -B node_modules/nodejs-whisper/cpp/whisper.cpp/build -DWHISPER_BUILD_EXAMPLES=ON -DWHISPER_BUILD_TESTS=OFF && cmake --build node_modules/nodejs-whisper/cpp/whisper.cpp/build --config Release --target whisper-cli --parallel 4",
    "build:main": "tsc --noEmit",
    "build:check": "node scripts/build-check.cjs",
    "test": "tsx tests/test_srt_ocr_normalizer_and_translation.ts",
    "test:downloader": "tsx tests/test_douyin_media_inspection.ts && tsx tests/test_download_inspection_ui.tsx",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tailwindcss/postcss": "^4.3.3",
    "@xyflow/react": "^12.11.6",
    "axios": "^1.20.0",
    "electron-store": "^11.0.2",
    "fluent-ffmpeg": "^2.1.3",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.34.0",
    "msedge-tts": "^2.0.7",
    "openai": "^7.5.0",
    "playwright-core": "^1.63.0",
    "sonner": "^2.0.8",
    "systeminformation": "^5.33.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^6.0.1",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "fast-uri@^3.0.0": "3.1.8",
    "js-yaml@^4.0.0": "4.3.2",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "electron": "^43.5.0",
    "electron-builder": "^26.15.3",
    "next": "^16.3.8",
    "nextron": "^10.3.0",
    "nodejs-whisper": "^0.3.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
